# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Loaded by companies_house_core.companies_house_extractor.load_dotenv(Path(".env")).

# Companies House Public Data + Document API (ingestion / enrichment).
COMPANIES_HOUSE_API_KEY=

# OpenRouter -- every LLM call in the repo (business-profile, VLM, eval judges).
OPENROUTER_API_KEY=

# Langfuse (self-hosted eval tracing -- see docs/LANGFUSE_SETUP.md).
# One Langfuse instance, one project per eval harness, one key pair per project.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY_BUSINESS_PROFILE=pk-lf-
LANGFUSE_SECRET_KEY_BUSINESS_PROFILE=sk-lf-
LANGFUSE_PUBLIC_KEY_VLM_FINANCIAL=pk-lf-
LANGFUSE_SECRET_KEY_VLM_FINANCIAL=sk-lf-

# Web stage search providers (docs/WEB_STAGE.md), each used on its free allowance.
# Serper.dev: 2,500 free credits, no card -- Google Maps listings and organic results (W1).
SERPER_API_KEY=
# DataForSEO: $1 free credit, no card -- keyword volume, cost per click, results with ads (W4).
# LOGIN is the account email; PASSWORD is the separate API password from the dashboard's
# API Access page, not the account password. Check both (free):
#   python -m scripts.website_analysis.search_providers check
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# SerpApi: 250 free searches a month -- Google Ads Transparency Center (W4).
SERPAPI_API_KEY=
# The friend's DataForSEO account (second account; leave blank until they agree). No default spending cap:
# every run on it states --dataforseo-allowance, agreed with them. Select it with --dataforseo-account friend.
DATAFORSEO_FRIEND_LOGIN=
DATAFORSEO_FRIEND_PASSWORD=

# Optional: private Ollama transport for the VLM pipeline (localhost tunnel only).
# PRIVATE_OLLAMA_BASE_URL=http://127.0.0.1:11434
